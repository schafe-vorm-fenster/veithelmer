---
layout: page.njk
title: Veit Helmer — Filmmaker
description: Films by Veit Helmer — A visual poetry of places, people, and silent storytelling
locale: en
permalink: /en/
---

{% from "macros/filmTile.njk" import filmTile %}

{# Categorize films by type #}
{% set categorizedFilms = collections.films_en | categorizeFilms %}

{# Feature Films Section #}
  {% if categorizedFilms.feature.length > 0 %}
  <section id="features" class="mb-20 scroll-mt-20">
    <h2 class="text-3xl font-bold mb-8 tracking-tight">{{ 'nav.features' | t(locale) }}</h2>
    
    <div class="horizontal-scroll-container overflow-x-auto overflow-y-hidden -mx-3 md:-mx-6 px-3 md:px-6 pb-3">
      <div class="flex gap-6 w-max">
        {% for film in categorizedFilms.feature %}
        <div class="w-80 flex-shrink-0">
          {% set filmSlug = film.filePathStem.split('/').slice(-2)[0] %}
          {% set posterBase = film.data.poster_image | replace('.jpg', '') | replace('.webp', '') %}
          {{ filmTile(
            title=film.data.title,
            year=film.data.release_year,
            image="/assets/films/" + filmSlug + "/" + posterBase,
            url=film.url | url,
            category="Feature"
          ) }}
        </div>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}
  
  {# Documentary Films Section #}
  {% if categorizedFilms.documentary.length > 0 %}
  <section id="documentaries" class="mb-20 scroll-mt-20">
    <h2 class="text-3xl font-bold mb-8 tracking-tight">{{ 'nav.documentaries' | t(locale) }}</h2>
    
    <div class="horizontal-scroll-container overflow-x-auto overflow-y-hidden -mx-3 md:-mx-6 px-3 md:px-6 pb-3">
      <div class="flex gap-6 w-max">
        {% for film in categorizedFilms.documentary %}
        <div class="w-80 flex-shrink-0">
          {% set filmSlug = film.filePathStem.split('/').slice(-2)[0] %}
          {% set posterBase = film.data.poster_image | replace('.jpg', '') | replace('.webp', '') %}
          {{ filmTile(
            title=film.data.title,
            year=film.data.release_year,
            image="/assets/films/" + filmSlug + "/" + posterBase,
            url=film.url | url,
            category="Documentary"
          ) }}
        </div>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}
  
  {# Short Films Section #}
  {% if categorizedFilms.short.length > 0 %}
  <section id="shorts" class="mb-20 scroll-mt-20">
    <h2 class="text-3xl font-bold mb-8 tracking-tight">{{ 'nav.shorts' | t(locale) }}</h2>
    
    <div class="horizontal-scroll-container overflow-x-auto overflow-y-hidden -mx-3 md:-mx-6 px-3 md:px-6 pb-3">
      <div class="flex gap-6 w-max">
        {% for film in categorizedFilms.short %}
        <div class="w-80 flex-shrink-0">
          {% set filmSlug = film.filePathStem.split('/').slice(-2)[0] %}
          {% set posterBase = film.data.poster_image | replace('.jpg', '') | replace('.webp', '') %}
          {{ filmTile(
            title=film.data.title,
            year=film.data.release_year,
            image="/assets/films/" + filmSlug + "/" + posterBase,
            url=film.url | url,
            category="Short"
          ) }}
        </div>
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

<style>
  {# Smooth horizontal scrolling #}
  .horizontal-scroll-container {
    scrollbar-width: auto;
    scrollbar-color: #ffffff rgba(255, 255, 255, 0.15);
    scroll-padding-left: 0.75rem;
  }
  
  .horizontal-scroll-container::-webkit-scrollbar {
    height: 14px;
  }
  
  .horizontal-scroll-container::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 7px;
    margin-left: 0.75rem;
    margin-right: 0.75rem;
  }
  
  @media (min-width: 768px) {
    .horizontal-scroll-container::-webkit-scrollbar-track {
      margin-left: 1.5rem;
      margin-right: 1.5rem;
    }
  }
  
  .horizontal-scroll-container::-webkit-scrollbar-thumb {
    background: #ffffff;
    border-radius: 7px;
    background-clip: padding-box;
    border: 3px solid transparent;
  }
  
  .horizontal-scroll-container::-webkit-scrollbar-thumb:hover {
    background: #f0f0f0;
    background-clip: padding-box;
    border: 3px solid transparent;
  }
</style>
